{
  "name": "nix-room",
  "version": "0.1.0-preview.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch server/src/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/src/main.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:failed": "playwright test --last-failed",
    "e2e:game": "playwright test --project chromium",
    "gen:scenes": "tsx tools/gen-placeholders.ts scenes/default default",
    "palette-snap": "tsx tools/palette-snap.ts",
    "typecheck": "tsc --noEmit",
    "art": "tsx tools/art/cli.ts",
    "build:desktop": "tsx tools/release/build.ts",
    "stage": "tsx tools/release/stage-cli.ts",
    "desktop": "npm run build:desktop && electron dist/desktop/main.mjs",
    "package:linux": "electron-builder --linux AppImage",
    "package:win": "electron-builder --win nsis zip",
    "e2e:desktop": "playwright test -c e2e-desktop/playwright.config.ts",
    "chat-stress": "tsx tools/chat-stress/run.ts",
    "st-rooms": "tsx tools/st-rooms/build.ts",
    "st-cast": "tsx tools/st-rooms/export-cast.ts",
    "map-render": "tsx tools/map3d/render.ts",
    "st-publish": "tsx tools/st-rooms/publish.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/tilt-neon": "^5.3.0",
    "@fontsource/vt323": "^5.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "pixi-filters": "^6.0.0",
    "pixi.js": "^8.0.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "^1.48.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "sharp": "0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "ws": "^8.18.0"
  }
}
