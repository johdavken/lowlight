# Everything here is optional: the game runs with no .env at all.

# Optional. >=16 chars. Guards the browser (the WebSocket). Unset: generated into data/settings.json.
# NIX_ROOM_TOKEN=

# Optional. settings.json (key, model picks, token), playthroughs and saves (git-ignored). Default shown.
DATA_DIR=./data

# Optional. Character folders (characters/<id>/character.json). Default shown.
CHARACTERS_DIR=./characters

# Optional. Scene packs (<pack>/<scene>/). Default shown.
SCENES_DIR=./scenes

# Optional. Port the server listens on (127.0.0.1 only). Default shown.
NIX_ROOM_PORT=7700
